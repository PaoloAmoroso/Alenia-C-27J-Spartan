<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>Smokebuoy.ac</path>

  <animation>
    <object-name>Smokebuoy</object-name>
  </animation>

  <animation>
    <type>billboard</type>
    <spherical>true</spherical>
  </animation>

  <animation>
    <type>dist-scale</type>
    <object-name>Smokebuoy</object-name>
    <interpolation>
      <entry><ind>   0 </ind><dep> 1.2 </dep></entry>
      <entry><ind> 800 </ind><dep> 2.0 </dep></entry>
    </interpolation>
  </animation>

  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>smokebuoy</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>Smokebuoy</object-name>
    <transparency>
      <alpha-prop>sim/time/elapsed-sec</alpha-prop>
      <factor>-0.05</factor>
      <offset>1.0</offset>
    </transparency>
  </animation>

</PropertyList>
